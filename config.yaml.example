# ============================================
# 合约配置
# ============================================
contracts:
  # CR信息合约地址
  cr_pool_address: "0xf042882D5a6eA81686702bf1E061E081839f87Aa"
  
  # BPoS节点信息合约地址
  bpos_pool_address: "0x9Dd1FA24C97224E2132F59A75cC1fD16230C280b"

# ============================================
# RPC配置
# ============================================
rpc:
  # 主链RPC地址
  main_chain: "https://api-testnet.elastos.io/ela"
  
  # PG链RPC地址 (用于合约交互)
  pg_chain: "https://api-testnet.elastos.io/pg"

# ============================================
# 更新配置
# ============================================
update:
  # 定期更新间隔
  # 支持格式: "1h", "24h", "1d", "30m" 等
  interval: "24h"

# ============================================
# 邮件配置
# ============================================
email:
  # 是否启用邮件通知
  enabled: true
  
  # 收件人列表
  to:
    - "admin@example.com"
    - "monitor@example.com"
  
  # 邮件主题前缀
  subject: "BPoS & CR Monitor"
  
  # SMTP服务器配置
  smtp:
    # SMTP服务器地址
    host: "smtp.gmail.com"
    
    # SMTP端口 (Gmail: 587, QQ邮箱: 587, 163邮箱: 25)
    port: 587
    
    # SMTP用户名 (通常是邮箱地址)
    username: "your_email@gmail.com"
    
    # SMTP密码 (Gmail需要使用应用专用密码)
    password: "your_app_password"
    
    # 发件人邮箱
    from: "your_email@gmail.com"
    
    # 发件人名称
    from_name: "BPoS CR Monitor"
    
    # 是否使用TLS (Gmail/QQ邮箱建议开启)
    tls: true

# ============================================
# 网页配置
# ============================================
web:
  # 是否启用网页生成
  enabled: true
  
  # 静态网页输出路径
  output_path: "./web"

# ============================================
# 账户配置
# ============================================
account:
  # 用于签名交易的私钥
  # 格式: hex字符串,不带0x前缀
  # 注意: 请妥善保管私钥,不要泄露!
  private_key: "your_private_key_hex_string_without_0x_prefix"

